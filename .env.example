PORT=3000

# Login credentials for callers: userId:password, comma-separated (HTTP Basic auth)
USERS=

# Optional API keys (x-api-key header). Leave empty to allow only USERS logins.
# Generate one with: openssl rand -hex 32
API_KEYS=

# Resend SMTP (password = Resend API key)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=

# Email settings
# Use onboarding@resend.dev until you verify your own domain at resend.com/domains
DEFAULT_FROM="Notify <onboarding@resend.dev>"

# Where replies go (optional); set to a real inbox
REPLY_TO=

# true = compose and return the message without sending
MAIL_DRY_RUN=false
